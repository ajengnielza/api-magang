APP_NAME=Api-magang
PORT=3000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=magang_db
DB_USER=postgres
DB_PASSWORD=your_password_here

# JWT — Access Token
JWT_SECRET=ganti-dengan-string-acak-yang-sangat-panjang-dan-rahasia
JWT_EXPIRES_IN=15m

# JWT — Refresh Token (WAJIB beda secret dari access token)
JWT_REFRESH_SECRET=ganti-dengan-string-acak-berbeda-dan-rahasia
JWT_REFRESH_EXPIRES_IN=7d